alert udp 192.168.18.12 any -> 192.168.18.11 5201 (msg:"THREAT INTELLIGENCE IP BLOCKED"; sid:1000002; rev:3;)
alert tcp any any -> $HOME_NET any (msg:"LOCAL POSSIBLE TCP SYN SCAN"; flags:S; flow:stateless; detection_filter:track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000003; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"LOCAL POSSIBLE ICMP FLOOD"; itype:8; detection_filter:track by_src, count 50, seconds 10; classtype:attempted-dos; sid:1000004; rev:1;)
alert tcp $HOME_NET any -> !$HOME_NET 4444 (msg:"LOCAL SUSPICIOUS OUTBOUND TCP CONNECTION TO PORT 4444"; flow:to_server; flags:S; classtype:trojan-activity; sid:1000005; rev:1;)
