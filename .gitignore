# Python virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]

# LocalStack runtime data
localstack-data/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs and generated test output
logs/
*.log

